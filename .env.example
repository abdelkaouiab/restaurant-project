# Copiez ce fichier vers .env pour le développement local uniquement.
# Ne commitez jamais .env. Les valeurs ci-dessous sont fictives et non utilisables.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant
DB_USERNAME=restaurant_app
DB_PASSWORD=change-me-locally

# Profil et origine du futur frontend local
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false
APP_SESSION_TIMEOUT=30m
APP_BCRYPT_STRENGTH=12
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_ATTEMPT_WINDOW=15m
APP_PRODUCT_IMAGES_DIRECTORY=./data/product-images
APP_PRODUCT_IMAGE_MAX_SIZE=5MB
APP_PRODUCT_IMAGE_MAX_REQUEST_SIZE=6MB
APP_PRODUCT_IMAGE_MAX_BYTES=5242880
APP_PRODUCT_IMAGE_MAX_PIXELS=12000000

# Production : valeurs obligatoires et distinctes de l'environnement local.
# SPRING_PROFILES_ACTIVE=prod
# APP_CORS_ALLOWED_ORIGINS=https://restaurant.example.com
# APP_PRODUCT_IMAGES_DIRECTORY=/var/lib/restaurant/product-images
# MANAGEMENT_SERVER_ADDRESS=127.0.0.1
# MANAGEMENT_SERVER_PORT=8081
# NVD_API_KEY=obtain-from-nvd-for-ci-only

# Docker Compose. Utilisez des chemins absolus pour les certificats montés.
COMPOSE_PROJECT_NAME=restaurant
APP_IMAGE_TAG=local
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443
APP_PUBLIC_ORIGIN=https://localhost:8443
TLS_CERTIFICATE_PATH=/absolute/path/to/fullchain.pem
TLS_PRIVATE_KEY_PATH=/absolute/path/to/privkey.pem
# L'utilisateur non-root du proxy doit pouvoir lire les deux fichiers TLS.
PROXY_UID=101
PROXY_GID=101
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=2

# À définir seulement lorsque le mécanisme d'authentification sera choisi.
# Ne pas inventer ou réutiliser une valeur d'exemple en production.
# APP_AUTH_SECRET=generate-a-strong-secret-locally
